[Unit]
Description=AI Daily 甲鱼主编版 build and unified-site publish
After=network-online.target ai-daily.service
Wants=network-online.target

[Service]
Type=oneshot
User=ai-daily
Group=ai-daily
WorkingDirectory=/www/wwwroot/ai-daily/app
Environment=HOME=/www/wwwroot/ai-daily/toolchain
Environment=UV_CACHE_DIR=/www/wwwroot/ai-daily/toolchain/cache
Environment=UV_PYTHON_INSTALL_DIR=/www/wwwroot/ai-daily/toolchain/python
Environment=AI_DAILY_SITE_ROOT=/www/wwwroot/ai-daily
EnvironmentFile=/etc/ai-daily/env
# Production remains site-only until a signed draft authorization, permanent
# cover media id, and both independent HMAC keys have been provisioned.
ExecStart=/www/wwwroot/ai-daily/toolchain/bin/uv run --frozen ai-daily persona-daily --mode site
TimeoutStartSec=1800
MemoryHigh=600M
MemoryMax=900M
CPUWeight=50
Nice=10
IOWeight=50
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ReadWritePaths=/www/wwwroot/ai-daily
ReadOnlyPaths=/www/wwwroot/ai-daily/app
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-daily-persona

[Install]
WantedBy=multi-user.target
