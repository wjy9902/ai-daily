[Unit]
Description=AI Daily digest build and publish
Documentation=file:///www/wwwroot/ai-daily/app/docs/plan/SELF-HOST-MIGRATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ai-daily
Group=ai-daily
WorkingDirectory=/www/wwwroot/ai-daily/app
Environment=HOME=/home/ai-daily
Environment=AI_DAILY_SITE_ROOT=/www/wwwroot/ai-daily
EnvironmentFile=/etc/ai-daily/env
ExecStart=/home/ai-daily/.local/bin/uv run --frozen ai-daily daily

# A run that has not finished in 30 minutes is stuck, not slow: collection is
# bounded by per-source timeouts and the model budget caps the rest.
TimeoutStartSec=1800

# Memory ceiling. This box also runs an LLM gateway and a tunnel endpoint, so
# the digest must not be able to starve them. Values come from measuring a real
# run under this cgroup; re-measure before raising them.
MemoryHigh=600M
MemoryMax=900M
CPUWeight=50
Nice=10
IOWeight=50

# This process parses hostile web content while holding model API keys, on a
# host that also stores other services' credentials. Everything below narrows
# what a compromised parser could reach.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# The only writable paths. Everything else on / is read-only to this unit.
ReadWritePaths=/www/wwwroot/ai-daily
ReadWritePaths=/home/ai-daily/.cache
ReadWritePaths=/home/ai-daily/.local

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-daily

[Install]
WantedBy=multi-user.target
