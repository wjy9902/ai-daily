[Unit]
Description=AI Daily publication windows
Documentation=file:///www/wwwroot/ai-daily/app/docs/plan/COLLECT-THEN-PUBLISH.md

[Timer]
# Server local time is already Asia/Shanghai.
# One issue a day. 06:30 reads what ai-daily-collect.timer gathered over the
# last day and a half plus one live fetch, then runs the model stages once.
# US afternoon news has settled by 05:00 Beijing; China's own morning news
# has not started. 07:30 is the retry, and it only spends model budget when
# 06:30 produced nothing or only a brief-only L2 issue (see cli._daily); an
# L1 or L0 already live makes it a no-op.
#
# tests/test_budget_staging.py reads the OnCalendar count here and
# tests/test_timers.py holds the schedule to this shape.
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 07:30:00
Persistent=true
AccuracySec=30s
RandomizedDelaySec=60s
Unit=ai-daily.service

[Install]
WantedBy=timers.target
