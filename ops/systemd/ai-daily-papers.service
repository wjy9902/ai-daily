[Unit]
Description=AI Daily papers deep-read build and publish
Documentation=file:///www/wwwroot/ai-daily/app/docs/plan/PAPERS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ai-daily
Group=ai-daily
WorkingDirectory=/www/wwwroot/ai-daily/app
Environment=HOME=/www/wwwroot/ai-daily/toolchain
Environment=UV_CACHE_DIR=/www/wwwroot/ai-daily/toolchain/cache
Environment=UV_PYTHON_INSTALL_DIR=/www/wwwroot/ai-daily/toolchain/python
Environment="GIT_SSH_COMMAND=ssh -F /www/wwwroot/ai-daily/.ssh/config"
Environment=AI_DAILY_SITE_ROOT=/www/wwwroot/ai-daily
EnvironmentFile=/etc/ai-daily/env
ExecStart=/www/wwwroot/ai-daily/toolchain/bin/uv run --frozen ai-daily papers --mode publish
ExecStartPost=-/www/wwwroot/ai-daily/app/ops/backup.sh

# The internal budgets have to fit inside this, and at 3600 they did not:
# selection runs ~15 min, the deep-read loop carries its own 40-minute deadline
# (papers.py), and the release step waits up to 10 for the publication lock.
# 65 > 60, so a run that used its full deep-read budget was killed by systemd
# before it could publish, which is how 2026-09-03 lost a finished issue.
TimeoutStartSec=7200
MemoryHigh=600M
MemoryMax=900M
CPUWeight=50
Nice=10
IOWeight=50

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

ReadWritePaths=/www/wwwroot/ai-daily
ReadOnlyPaths=/www/wwwroot/ai-daily/app

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-daily-papers

[Install]
WantedBy=multi-user.target
