[Unit]
Description=甲鱼主编版 publication windows

[Timer]
# These must all fall after the last base window in ai-daily.timer. A persona
# edition freezes the day's upstream marker (_persona_date_is_frozen), so a
# persona run scheduled before a base window would make that window's upgrade
# impossible to publish — which is what 07:10 would have done to the 08:30
# base window added for late-breaking morning news.
OnCalendar=*-*-* 08:50:00
OnCalendar=*-*-* 09:20:00
OnCalendar=*-*-* 09:50:00
Persistent=true
AccuracySec=30s
RandomizedDelaySec=30s
Unit=ai-daily-persona.service

[Install]
WantedBy=timers.target
