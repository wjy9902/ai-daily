[Unit]
Description=AI Daily papers publication window
Documentation=file:///www/wwwroot/ai-daily/app/docs/plan/PAPERS.md

[Timer]
# Server local time is Asia/Shanghai. This avoids every daily digest window.
# After the 06:30 issue and its 07:30 retry: the paper selection reads the
# daily's latest run for cross signals, and at 06:10 that was yesterday's.
OnCalendar=*-*-* 07:45:00
Persistent=true
AccuracySec=30s
RandomizedDelaySec=60s
Unit=ai-daily-papers.service

[Install]
WantedBy=timers.target
